// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("FACULTY")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty Faculty?

  @@map("users")
}

model Faculty {
  id          String   @id @default(cuid())
  name        String
  title       String
  description String
  department  String
  email       String
  phone       String?
  linkedin    String?
  twitter     String?
  expertise   String[]
  about       String
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  qualifications      Qualification[]
  certifications      Certification[]
  experiences         Experience[]
  courses             Course[]
  researchProjects    ResearchProject[]
  publications        Publication[]
  outreachActivities  OutreachActivity[]
  blogPosts           BlogPost[]

  @@map("faculty")
}

model Qualification {
  id        String  @id @default(cuid())
  degree    String
  school    String
  year      String
  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("qualifications")
}

model Certification {
  id           String  @id @default(cuid())
  name         String
  organization String
  year         String
  facultyId    String
  faculty      Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("certifications")
}

model Experience {
  id          String  @id @default(cuid())
  title       String
  company     String
  startYear   String
  endYear     String?
  description String?
  facultyId   String
  faculty     Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("experiences")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  code        String
  description String
  semester    String
  year        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  materials StudyMaterial[]

  @@map("courses")
}

model StudyMaterial {
  id          String   @id @default(cuid())
  title       String
  description String?
  type        String // PDF, VIDEO, LINK, etc.
  url         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  topics Topic[]

  @@map("study_materials")
}

model Topic {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materialId String
  material   StudyMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("topics")
}

model ResearchProject {
  id          String    @id @default(cuid())
  title       String
  description String
  startDate   DateTime
  endDate     DateTime?
  status      String    @default("ONGOING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("research_projects")
}

model Publication {
  id          String   @id @default(cuid())
  title       String
  authors     String[]
  journal     String?
  conference  String?
  year        String
  doi         String?
  url         String?
  abstract    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("publications")
}

model OutreachActivity {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  location    String?
  type        String // WORKSHOP, SEMINAR, CONFERENCE, etc.
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("outreach_activities")
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  content     String
  excerpt     String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  facultyId String
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@map("blog_posts")
}
